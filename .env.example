# ============================================================
# MnemoLite — Environment Configuration
# ============================================================
# All variables have defaults in api/core/settings.py (AppSettings).
# Only set variables here if you need to override the defaults.
# Run: python3 -c "from api.core import get_settings; print(get_settings())"
# to see all current values.

# === Base de donnees ===
# DATABASE_URL=             # REQUIRED — no default, set in docker-compose
# TEST_DATABASE_URL=        # Default: "" (empty = disabled)
# MCP_DATABASE_URL=         # Default: ""
# REDIS_URL=redis://redis:6379/0
# REDIS_HOST=redis
# REDIS_PORT=6379
# POSTGRES_USER=mnemo
# POSTGRES_PASSWORD=mnemopass
# POSTGRES_DB=mnemolite
# POSTGRES_PORT=5432

# === Application ===
# DEBUG=false
# LOG_LEVEL=INFO
# SECRET_KEY=               # REQUIRED for production
# API_PORT=8001
# ENVIRONMENT=development

# === Embedding (SSOT — dimensions auto-deduced) ===
# EMBEDDING_MODEL=BAAI/bge-m3       # Default (1024D, best multilingual)
# CODE_EMBEDDING_MODEL=jinaai/jina-embeddings-v2-base-code
# EMBEDDING_MODE=real               # real | stub | mock
# EMBEDDING_DEVICE=cpu
# EMBEDDING_CACHE_SIZE=1000
# USE_ONNX=false                    # Enable ONNX runtime for faster inference
# GLINER_MODEL_PATH=/app/models/gliner_multi-v2.1

# === Auth & Rate Limiting ===
# MNEMO_AUTH_ENABLED=false
# MNEMO_API_KEYS=                   # comma-separated key:name pairs
# MNEMO_RATE_LIMIT_ENABLED=true
# MNEMO_RATE_LIMIT_MAX=100
# MNEMO_RATE_LIMIT_WINDOW=60

# === Auto-Import / Watcher ===
# TYPESCRIPT_LSP_ENABLED=true
# CLAUDE_PROJECTS_DIR=/home/user/.claude/projects
# CODEBUFF_DIR=/home/user/.config/manicode/projects
# OPENCODE_DIR=/home/user/.local/share/opencode
# ACTIVE_PROJECT=mnemolite
# ENABLE_AUTO_IMPORT=false
# CONVERSATION_WATCHER_ENABLED=true
# POLL_INTERVAL=30
# IMPORT_HISTORICAL=false
# WATCHER_LOG_FORMAT=text

# === MCP Server ===
# MCP_PRIVACY_ENABLED=true
# MCP_TRANSPORT=http
# MCP_HTTP_HOST=0.0.0.0
# MCP_HTTP_PORT=8002
# MCP_AUTH_MODE=none

# === Feature Flags ===
# ENTITY_EXTRACTION_ENABLED=true
# ENTITY_EXTRACTION_MEMORY_TYPES=decision,reference,note,investigation
# ENTITY_EXTRACTION_SYSTEM_TAGS=sys:core,sys:anchor,sys:pattern
# QUERY_UNDERSTANDING_ENABLED=false
# QUERY_UNDERSTANDING_FALLBACK=true

# === Upload ===
# UPLOAD_BATCH_SIZE=10
# UPLOAD_INDEXING_TIMEOUT=300

# === Observabilite (OpenObserve) ===
# O2_URL=http://openobserve:5080
# O2_USER=
# O2_PASSWORD=
# OTLP_ENDPOINT=http://openobserve:5080/api/default
# OTLP_METRICS_ENDPOINT=http://openobserve:5080/api/default

# === Frontend ===
# VITE_API_URL=http://localhost:8001
