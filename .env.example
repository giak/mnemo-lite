# ============================================================
# MnemoLite — Environment Configuration
# ============================================================
# All variables have defaults in api/core/settings.py (AppSettings).
# Only set variables here if you need to override the defaults.
# Run: python3 -c "from api.core import get_settings; print(get_settings())"
# to see all current values.

# === Base de donnees ===
# DATABASE_URL=             # REQUIRED — no default, set in docker-compose
# TEST_DATABASE_URL=        # Default: "" (empty = disabled)
# MCP_DATABASE_URL=         # Default: ""
# REDIS_URL=redis://redis:6379/0
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD=                 # Mot de passe Redis (optionnel)
# REDIS_DB=0                       # Index Redis
# POSTGRES_USER=mnemo
# POSTGRES_PASSWORD=              # REQUIRED: pas de fallback par defaut     # ⚠️ CHANGE THIS in production!
# POSTGRES_DB=mnemolite
# POSTGRES_PORT=5432
# POSTGRES_HOST=db

# === SMTP ===
# SMTP_HOST=localhost
# SMTP_PORT=25

# === Application ===
# DEBUG=false
# LOG_LEVEL=INFO
# SECRET_KEY=               # REQUIRED for production
# API_PORT=8001
# ENVIRONMENT=development
# API_URL=http://api:8000              # URL interne pour les workers

# === Embedding (SSOT — dimensions auto-deduced) ===
# Model options (all with auto-deduced dimensions):
#   BAAI/bge-m3 (default) — 1024D, +22% better French quality
#   intfloat/multilingual-e5-base — 768D, good multilingual
#   intfloat/multilingual-e5-large — 1024D, best accuracy
#   nomic-ai/nomic-embed-text-v1.5 — 768D, fast on CPU
# EMBEDDING_MODEL=BAAI/bge-m3       # Default (1024D, best multilingual)
# CODE_EMBEDDING_MODEL=jinaai/jina-embeddings-v2-base-code
# CODE_EMBEDDING_DIMENSION=             # Auto-deduit du modele (768 pour jina-code)
# EMBEDDING_BACKEND=                    # Auto-deduit du registre; fallback pytorch
# EMBEDDING_DIMENSION=                 # Auto-deduit du modele (1024 pour BGE-M3, 768 pour e5)
# EMBEDDING_MODE=real               # real | stub | mock
# EMBEDDING_AUTO_GENERATE=true        # Generer automatiquement les embeddings a l'indexation
# EMBEDDING_FAIL_STRATEGY=soft        # soft | hard (comportement en cas d'echec)
# EMBEDDING_SOURCE_FIELDS=text,body,message,content,title
# EMBEDDING_DEVICE=cpu
# EMBEDDING_CACHE_SIZE=1000
# L1_CACHE_SIZE_MB=100                  # Taille du cache L1 en MB
# USE_ONNX=false                    # Enable ONNX runtime for faster inference
# GLINER_MODEL_PATH=/app/models/gliner_multi-v2.1
# GLINER_MODEL=piEsposito/gliner-multi-v2.1       # Modele GLiNER pour extraction d'entites
# EMBEDDING_PREFIX=Represent this passage for retrieval:  
# EMBEDDING_MAX_TOKENS=8192               # Limite native BGE-M3 (tokens)
# EMBEDDING_CHUNK_SIZE=8000               # Taille des chunks pour textes longs
# EMBEDDING_CHUNK_OVERLAP=256             # Overlap entre chunks consecutifs
# EMBEDDING_MAX_CONTENT_LENGTH=100000     # Hard RAM safety limit (caracteres)

# === Auth & Rate Limiting ===
# MNEMO_AUTH_ENABLED=false
# MNEMO_API_KEYS=                   # comma-separated key:name pairs
# MNEMO_RATE_LIMIT_ENABLED=false
# MNEMO_RATE_LIMIT_MAX=100
# MNEMO_RATE_LIMIT_WINDOW=60

# === Auto-Import / Watcher ===
# TYPESCRIPT_LSP_ENABLED=false
# CLAUDE_PROJECTS_DIR=/home/user/.claude/projects
# CODEBUFF_PROJECTS_DIR=/home/user/.config/manicode/projects
# CODEBUFF_DIR=/home/user/.config/manicode/projects
# OPENCODE_DIR=/home/user/.local/share/opencode
# OPENCODE_DB_PATH=              # Chemin DB Opencode (optionnel)
# ACTIVE_PROJECT=mnemolite
# ENABLE_AUTO_IMPORT=false
# CONVERSATION_WATCHER_ENABLED=true
# POLL_INTERVAL=30
# WORKER_POLL_INTERVAL=5           # Intervalle de polling des workers (secondes)

# === Retry Configuration ===
# Cache operations (Redis transient failures)
# CACHE_RETRY_MAX_ATTEMPTS=3
# CACHE_RETRY_BASE_DELAY=0.5
# CACHE_RETRY_MAX_DELAY=5.0
# CACHE_RETRY_JITTER=true

# Database operations (connection pool, deadlocks)
# DATABASE_RETRY_MAX_ATTEMPTS=3
# DATABASE_RETRY_BASE_DELAY=1.0
# DATABASE_RETRY_MAX_DELAY=10.0
# DATABASE_RETRY_JITTER=true

# Embedding operations (slow)
# EMBEDDING_RETRY_MAX_ATTEMPTS=2
# EMBEDDING_RETRY_BASE_DELAY=2.0
# EMBEDDING_RETRY_MAX_DELAY=10.0
# EMBEDDING_RETRY_JITTER=true

# Default retry
# DEFAULT_RETRY_MAX_ATTEMPTS=3
# DEFAULT_RETRY_BASE_DELAY=1.0
# DEFAULT_RETRY_MAX_DELAY=30.0
# DEFAULT_RETRY_JITTER=true           # Intervalle de polling des workers (secondes)
# WORKER_BATCH_SIZE=50             # Taille de lot des workers
# IMPORT_HISTORICAL=false
# WATCHER_LOG_FORMAT=text
# MNEMO_WATCHER_STATE=/tmp/mnemo-watcher-state.json

# === MCP Server ===
# MCP_PRIVACY_ENABLED=true
# MCP_TRANSPORT=http
# MCP_HTTP_HOST=0.0.0.0
# MCP_HTTP_PORT=8002
# MCP_URL=http://localhost:8002/mcp  # URL interne pour les tests MCP
# MCP_AUTH_MODE=none

# === Feature Flags ===
# ENTITY_EXTRACTION_ENABLED=true
# ENTITY_EXTRACTION_MEMORY_TYPES=decision,reference,note,investigation
# ENTITY_EXTRACTION_SYSTEM_TAGS=sys:core,sys:anchor,sys:pattern
# QUERY_UNDERSTANDING_ENABLED=false
# QUERY_UNDERSTANDING_FALLBACK=true

# === Upload ===
# UPLOAD_BATCH_SIZE=10
# UPLOAD_INDEXING_TIMEOUT=300

# === Observabilite (OpenObserve) ===
# O2_URL=http://openobserve:5080
# O2_USER=
# O2_PASSWORD=
# OTLP_ENDPOINT=http://openobserve:5080/api/default/v1/traces
# OTLP_METRICS_ENDPOINT=http://openobserve:5080/api/default/v1/metrics

# === Timeouts (secondes, tous optionnels — defaults ci-dessous) ===
# Tous les timeouts sont lus depuis api/config/timeouts.py
# TIMEOUT_TREE_SITTER=5.0          # Parsing arbre syntaxique
# TIMEOUT_EMBEDDING_SINGLE=30.0    # Generation d'embedding unique
# TIMEOUT_EMBEDDING_BATCH=60.0     # Generation d'embedding par lot
# TIMEOUT_GRAPH_CONSTRUCTION=300.0 # Construction de graphe
# TIMEOUT_GRAPH_TRAVERSAL=5.0      # Traversee de graphe
# TIMEOUT_VECTOR_SEARCH=5.0        # Recherche vectorielle
# TIMEOUT_LEXICAL_SEARCH=3.0       # Recherche lexicale
# TIMEOUT_HYBRID_SEARCH=10.0       # Recherche hybride
# TIMEOUT_CACHE_GET=1.0            # Lecture cache
# TIMEOUT_CACHE_PUT=2.0            # Ecriture cache
# TIMEOUT_DATABASE_QUERY=10.0      # Requete SQL
# TIMEOUT_DATABASE_TRANSACTION=30.0# Transaction SQL
# TIMEOUT_INDEX_FILE=60.0          # Indexation de fichier

# === Circuit Breakers (seuils, tous optionnels — defaults ci-dessous) ===
# Tous les circuit breakers sont lus depuis api/config/circuit_breakers.py
# REDIS_CIRCUIT_FAILURE_THRESHOLD=5
# REDIS_CIRCUIT_RECOVERY_TIMEOUT=30
# REDIS_CIRCUIT_HALF_OPEN_CALLS=1
# EMBEDDING_CIRCUIT_FAILURE_THRESHOLD=3
# EMBEDDING_CIRCUIT_RECOVERY_TIMEOUT=60
# EMBEDDING_CIRCUIT_HALF_OPEN_CALLS=1
# DATABASE_CIRCUIT_FAILURE_THRESHOLD=3
# DATABASE_CIRCUIT_RECOVERY_TIMEOUT=10
# DATABASE_CIRCUIT_HALF_OPEN_CALLS=1

# === Scripts (utilitaires, valeurs par defaut) ===
# MIN_SCORE=0.1                         # Seuil minimal de score de similarite
# CHUNK_SIZE=1000                       # Taille de lot pour le traitement par lots
# API_BASE_URL=http://localhost:8001     # URL de base pour les scripts de test

# === Frontend ===
# VITE_API_URL=http://localhost:8001
